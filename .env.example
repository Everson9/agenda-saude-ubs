# Copie para .env e ajuste: cp .env.example .env
# O .env fica fora do Git. Nunca coloque segredo real neste arquivo de exemplo.

# Porta HTTP do servidor
PORT=3000

# Arquivo onde os dados são salvos (a pasta data/ está no .gitignore)
DB_ARQUIVO=data/db.json

# Usuário da recepção
AUTH_USUARIO=recepcao

# Hash da senha da recepção. Gere com: npm run hash-senha -- "sua senha forte"
# Cole entre aspas simples, porque o hash tem "$": AUTH_SENHA_HASH='scrypt$...'
# Vazio = usa a senha de desenvolvimento recepcao123 (só para rodar na sua máquina).
AUTH_SENHA_HASH=

# Segredo que assina os tokens de sessão. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Vazio = segredo aleatório a cada início (as sessões caem quando o servidor reinicia).
AUTH_SEGREDO=
